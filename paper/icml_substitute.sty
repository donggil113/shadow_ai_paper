%% icml_substitute.sty -- geometry-matched stand-in for the official ICML style.
%%
%% The ICML 2027 style file has not been published (as of 2026-09-15) and the
%% official ICML style host (media.icml.cc) is unreachable from the build
%% environment, so this package reproduces the ICML page geometry and exposes
%% the SAME author-facing macro API as icmlYYYY.sty
%% (\icmltitle, \icmlauthor, \icmlaffiliation, \icmlcorrespondingauthor,
%%  \icmlkeywords, \printAffiliationsAndNotice, icmlauthorlist, ...).
%% At submission time replace  \usepackage{icml_substitute}  in main.tex by
%% \usepackage{icml2027}  and delete this file; no other change is needed.
%%
%% Geometry (matches icml2024/2025.sty): US letter, two columns, 10pt Times,
%% text block 6.75in x 9in, column separation 0.25in, 1in top margin,
%% 0.75in side margins, 4pt/6pt paragraph skips, ragged-bottom columns.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml_substitute}[2026/09/15 v0.1 ICML geometry stand-in]

\newif\ificmlaccepted
\DeclareOption{accepted}{\icmlacceptedtrue}
\ProcessOptions\relax

\RequirePackage[letterpaper,textwidth=6.75in,textheight=9in,top=1in,left=0.75in,columnsep=0.25in,headheight=12pt,headsep=12pt,footskip=24pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{times}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{caption}
\RequirePackage{etoolbox}

\raggedbottom
\setlength{\parskip}{0pt}
\setlength{\parindent}{1em}
\setlength{\abovedisplayskip}{4pt plus 1pt minus 1pt}
\setlength{\belowdisplayskip}{4pt plus 1pt minus 1pt}
\renewcommand{\baselinestretch}{1.0}

% --- section formatting (ICML: 12pt bold sections, 11pt bold subsections) ---
\titleformat{\section}{\large\bfseries\raggedright}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries\raggedright}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape\raggedright}{\thesubsubsection}{1em}{}
\titlespacing*{\section}{0pt}{10pt plus 2pt minus 2pt}{4pt}
\titlespacing*{\subsection}{0pt}{8pt plus 2pt minus 2pt}{3pt}
\titlespacing*{\subsubsection}{0pt}{6pt plus 1pt minus 1pt}{2pt}
\titlespacing*{\paragraph}{0pt}{4pt}{1em}

\captionsetup{font=small,labelfont=bf,skip=4pt}

% --- ICML author-facing API ---------------------------------------------------
\newcommand{\icmltitlerunning}[1]{\gdef\icml@runningtitle{#1}}
\gdef\icml@runningtitle{}
\newcommand{\icmltitle}[1]{\gdef\icml@title{#1}}
\gdef\icml@title{}
\newcommand{\icmlsetsymbol}[2]{\expandafter\gdef\csname icmlsym@#1\endcsname{#2}}
\newcommand{\icmlkeywords}[1]{\gdef\icml@keywords{#1}}
\gdef\icml@keywords{}
\newcommand{\icmlEqualContribution}{\textsuperscript{*}Equal contribution }
\gdef\icml@authors{}
\gdef\icml@affils{}
\gdef\icml@corr{}
\newcommand{\icmlauthor}[2]{\g@addto@macro\icml@authors{#1\textsuperscript{#2}\quad}}
\newcommand{\icmlaffiliation}[2]{\g@addto@macro\icml@affils{\textsuperscript{#1}#2. }}
\newcommand{\icmlcorrespondingauthor}[2]{\g@addto@macro\icml@corr{Correspondence to: #1 \textless #2\textgreater. }}
\newenvironment{icmlauthorlist}{}{}

\newcommand{\printAffiliationsAndNotice}[1]{%
  \begingroup\footnotesize
  \ificmlaccepted
    \icml@affils\ \icml@corr\par\medskip #1\par
  \else
    \textit{Preliminary work. Under review by the International Conference on
    Machine Learning (ICML). Do not distribute.}\par
  \fi
  \endgroup\medskip}

% --- title block: two-column layout with a full-width title, as in ICML ---
\renewcommand{\maketitle}{%
  \twocolumn[{%
    \begin{center}
      {\Large\bfseries\icml@title\par}\vskip 0.8em
      \ificmlaccepted{\normalsize\icml@authors\par}\else{\normalsize Anonymous Authors\textsuperscript{1}\par}\fi
    \end{center}\vskip 1em}]%
  \pagestyle{fancy}\fancyhf{}%
  \fancyhead[C]{\footnotesize\icml@runningtitle}%
  \renewcommand{\headrulewidth}{0pt}%
  \thispagestyle{fancy}}

% --- abstract as an unnumbered section, ICML-style ---
\renewenvironment{abstract}{\section*{Abstract}\small}{\par\vskip 0.5em}
\endinput
